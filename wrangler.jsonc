{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remy-auth-app",
  "compatibility_date": "2026-09-24",
  // Static assets only: every public page is prerendered. `/en` serves en/index.html without a
  // trailing-slash redirect, and unknown paths get 404.html with a 404 status.
  "assets": { "directory": "./build/client", "html_handling": "drop-trailing-slash", "not_found_handling": "404-page" }
}
