{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remy-auth-app",
  "compatibility_date": "2026-09-24",
  // Every public page is prerendered into build/client. The Worker runs first on every request
  // for request IDs, the shared log contract and /healthz, then serves the asset: `/en` without
  // a trailing-slash redirect, and 404.html with a 404 status for anything unknown.
  "main": "./workers/app.ts",
  "assets": { "directory": "./build/client", "binding": "ASSETS", "run_worker_first": true, "html_handling": "drop-trailing-slash", "not_found_handling": "404-page" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "ENVIRONMENT": "production" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 }
  }
}
